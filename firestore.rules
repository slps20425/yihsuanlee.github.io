rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Configuration: Read-only for clients (Admin SDK bypasses this)
    match /configuration/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Users: Users can read/write their own data
    // (Adjust read if profiles are public)
    match /users/{userId} {
      allow read: if true; 
      allow write: if request.auth != null && request.auth.uid == userId; // strictly referencing 'uid' logic from code
    }

    // Admin Dev Tasks
    match /dev_task/{taskId} {
      allow read: if true;
      allow create: if request.auth != null;
      // UPDATE: Only owner can update
      allow update: if request.auth != null && (
        resource.data.createdBy.uid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid // Handle legacy string case if any
      );
      // DELETE: Only owner can delete
      allow delete: if request.auth != null && (
        resource.data.createdBy.uid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      );
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
